// Prisma schema for R.K. Automobile
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Inquiry {
  id        String   @id @default(cuid())
  type      String   // "buy" | "sell" | "contact" | "finance" | "test-drive"
  name      String
  phone     String
  email     String?
  carId     String?
  carName   String?
  message   String?
  budget    Int?
  status    String   @default("new") // new | contacted | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model CarInquiry {
  id        String   @id @default(cuid())
  carId     String
  carName   String
  name      String
  phone     String
  message   String?
  createdAt DateTime @default(now())

  @@index([carId])
}

model Newsletter {
  id        String   @id @default(cuid())
  phone     String   @unique
  createdAt DateTime @default(now())
}
